  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "섹션 1 결과 — RabbitMQ 중단 중 이벤트 유실 0",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "RabbitMQ 연결 (앱 기준)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "expr": "clamp_max(max(rabbitmq_connections), 1)",
          "legendFormat": "연결",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "중단",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "연결",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "가입 요청/초",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/loadtest/join\"}[30s]))",
          "legendFormat": "가입 요청/초",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "즉시 발행 스레드 (Async Thread)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "executor_active_threads{name=\"eventAsyncExecutor\"}",
          "legendFormat": "실행 중",
          "refId": "A"
        },
        {
          "expr": "executor_queued_tasks{name=\"eventAsyncExecutor\"}",
          "legendFormat": "대기줄",
          "refId": "B"
        },
        {
          "expr": "executor_pool_max_threads{name=\"eventAsyncExecutor\"}",
          "legendFormat": "최대",
          "refId": "C"
